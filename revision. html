const $ = id => document.getElementById(id);
let quizQuestions = [];
let paperQuestions = [];
let submitted = false;

function shuffle(items){
 const arr = [...items];
 for(let i=arr.length-1;i>0;i--){
  const j=Math.floor(Math.random()*(i+1));
  [arr[i],arr[j]]=[arr[j],arr[i]];
 }
 return arr;
}
function filteredBank(){
 const g=Number($("grade").value), s=$("subject").value;
 const t=$("topic").value, d=$("difficulty").value;
 return BANK.filter(x=>x.g===g && x.s===s &&
  (t==="all"||x.t===t) && (d==="all"||x.d===d));
}
function updateTopics(){
 const old=$("topic").value;
 const topics=[...new Set(BANK.filter(x=>
  x.g===Number($("grade").value)&&x.s===$("subject").value
 ).map(x=>x.t))].sort();
 $("topic").innerHTML='<option value="all">All topics</option>'+
  topics.map(t=>`<option value="${escapeHTML(t)}">${escapeHTML(t)}</option>`).join("");
 if(topics.includes(old)) $("topic").value=old;
 updateCount();
}
function updateCount(){
 const list=filteredBank();
 $("bankCount").textContent=`${list.length} matching starter question(s) available for this selection.`;
}
function escapeHTML(value){
 return String(value).replace(/[&<>"']/g,c=>({
  "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
 }[c]));
}
function startQuiz(){
 const pool=shuffle(filteredBank());
 if(!pool.length){
  $("quizArea").innerHTML="<p>No questions match these filters yet. Choose another topic or subject.</p>";
  $("quizControls").innerHTML="";
  $("results").innerHTML="";
  return;
 }
 quizQuestions=pool.slice(0,Math.min(10,pool.length));
 submitted=false;
 $("results").innerHTML="";
 $("quizArea").innerHTML=quizQuestions.map((x,i)=>`
  <article class="question">
   <span class="pill">Question ${i+1}</span>
   <span class="pill">${escapeHTML(x.t)}</span>
   <span class="pill">${escapeHTML(x.d)}</span>
   <p><strong>${i+1}. ${escapeHTML(x.q)}</strong></p>
   ${x.o.map((o,j)=>`
    <label class="option">
     <input type="radio" name="q${i}" value="${j}">
     <span>${String.fromCharCode(65+j)}. ${escapeHTML(o)}</span>
    </label>`).join("")}
   <div id="feedback${i}"></div>
  </article>`).join("");
 $("quizControls").innerHTML='<button class="primary" id="submitQuiz">Submit answers</button> <button class="secondary" id="anotherQuiz">New randomized quiz</button>';
 $("submitQuiz").addEventListener("click",submitQuiz);
 $("anotherQuiz").addEventListener("click",startQuiz);
}
function submitQuiz(){
 if(submitted)return;
 let score=0,answered=0;
 quizQuestions.forEach((x,i)=>{
  const selected=document.querySelector(`input[name="q${i}"]:checked`);
  const box=$(`feedback${i}`);
  if(selected){
   answered++;
   if(Number(selected.value)===x.a) score++;
  }
  box.className="feedback";
  box.innerHTML=`
   <div class="${selected&&Number(selected.value)===x.a?'correct':'wrong'}">
    ${selected&&Number(selected.value)===x.a?'Correct!':selected?'Not quite.':'Not answered.'}
    Correct answer: ${String.fromCharCode(65+x.a)}. ${escapeHTML(x.o[x.a])}
   </div>
   <div><strong>Explanation:</strong> ${escapeHTML(x.e)}</div>`;
 });
 submitted=true;
 document.querySelectorAll('#quizArea input').forEach(el=>el.disabled=true);
 $("results").innerHTML=`<h3>Your score: ${score}/${quizQuestions.length}</h3>
  <p>You answered ${answered} of ${quizQuestions.length} questions. Review the explanations above to strengthen your understanding.</p>`;
}
function generatePaper(){
 const pool=shuffle(filteredBank());
 if(!pool.length){
  $("paper").innerHTML="<p>No questions match these filters. Choose another selection.</p>";
  return;
 }
 const count=Math.min(Number($("paperCount").value),pool.length);
 paperQuestions=pool.slice(0,count);
 const grade=$("grade").value, subject=$("subject").value;
 const showAnswers=$("includeAnswers").value==="yes";
 $("paper").innerHTML=`
  <div class="paper-head">
   <h2>SomaHub CBC Practice Paper</h2>
   <p><strong>Grade:</strong> ${grade} &nbsp; <strong>Subject:</strong> ${escapeHTML(subject)}</p>
   <p><strong>Topic:</strong> ${escapeHTML($("topic").value==="all"?"Mixed topics":$("topic").value)}
   &nbsp; <strong>Questions:</strong> ${count}</p>
   <p>Name: __________________________________ Date: __________________</p>
  </div>
  <hr>
  <p><strong>Instructions:</strong> Answer all questions. Choose one answer for each multiple-choice question. This is original revision material, not an official KNEC paper.</p>
  ${paperQuestions.map((x,i)=>`
   <div class="paper-question">
    <p><strong>${i+1}. ${escapeHTML(x.q)} (1 mark)</strong></p>
    <ol type="A">${x.o.map(o=>`<li>${escapeHTML(o)}</li>`).join("")}</ol>
   </div>`).join("")}
  <p><strong>Total: ${count} marks</strong></p>
  ${showAnswers?`<div class="answer-key"><h2>Answer Guide and Explanations</h2>
   ${paperQuestions.map((x,i)=>`<p><strong>${i+1}. ${String.fromCharCode(65+x.a)}. ${escapeHTML(x.o[x.a])}</strong><br>${escapeHTML(x.e)}</p>`).join("")}
  </div>`:""}`;
}
$("grade").addEventListener("change",()=>{updateTopics();$("quizArea").innerHTML="<p>Choose Start randomized quiz to begin.</p>";});
$("subject").addEventListener("change",()=>{updateTopics();$("quizArea").innerHTML="<p>Choose Start randomized quiz to begin.</p>";});
$("topic").addEventListener("change",updateCount);
$("difficulty").addEventListener("change",updateCount);
$("startQuiz").addEventListener("click",startQuiz);
$("refreshQuestions").addEventListener("click",()=>{
 updateCount();
 if(quizQuestions.length) startQuiz();
});
$("makePaper").addEventListener("click",generatePaper);
